---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { Terminal, Home, ArrowLeft } from 'lucide-react';
---

<BaseLayout title="404 — Page Not Found | Ashan Kavinda">
  <Navbar />
  <main class="flex-1 flex items-center justify-center py-24 sm:py-32">
    <Container size="md" class="text-center space-y-8">
      <!-- Terminal Error Box -->
      <div class="max-w-md mx-auto rounded-xl border border-border/80 bg-card p-6 shadow-xl space-y-4 font-mono text-xs sm:text-sm text-left">
        <div class="flex items-center gap-2 border-b border-border/50 pb-3 text-muted-foreground">
          <div class="w-3 h-3 rounded-full bg-destructive/60"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500/60"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/60"></div>
          <span class="ml-2">ashan@workspace:~</span>
        </div>

        <div class="space-y-2">
          <div class="text-destructive flex items-center gap-2">
            <Terminal className="w-4 h-4 text-destructive" />
            <span class="font-bold">404_ROUTE_NOT_FOUND</span>
          </div>
          <p class="text-muted-foreground text-xs leading-relaxed">
            The requested path could not be located in the workspace file tree.
          </p>
        </div>
      </div>

      <div class="space-y-3 max-w-lg mx-auto">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          Page Not Found
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground">
          The URL you are looking for doesn't exist or has been moved.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <Button href="/" variant="primary" size="md">
          <Home className="w-4 h-4 mr-1.5" />
          <span>Return Home</span>
        </Button>

        <Button href="/projects" variant="outline" size="md">
          <ArrowLeft className="w-4 h-4 mr-1.5" />
          <span>Browse Projects</span>
        </Button>
      </div>
    </Container>
  </main>
  <Footer />
</BaseLayout>
