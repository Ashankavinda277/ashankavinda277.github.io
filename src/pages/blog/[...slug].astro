---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, Calendar, Clock, User } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} — Ashan Kavinda`} description={post.data.description}>
  <Navbar />

  <main class="flex-1 py-16 sm:py-24 bg-grid-pattern">
    <Container size="md" class="space-y-10">
      
      <!-- Back Link -->
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Back to all articles</span>
      </a>

      <!-- Header Information Card -->
      <header class="space-y-6 rounded-card border border-border bg-card p-8">
        <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
          <div class="flex items-center gap-1.5">
            <Calendar className="w-4 h-4" />
            <span>{formattedDate}</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <Clock className="w-4 h-4" />
            <span>{post.data.readTime}</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <User className="w-4 h-4" />
            <span>{post.data.author}</span>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-foreground leading-tight">
          {post.data.title}
        </h1>

        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
          {post.data.description}
        </p>

        <div class="flex flex-wrap gap-2 border-t border-border pt-4">
          {post.data.tags.map((tag) => (
            <Badge variant="outline">{tag}</Badge>
          ))}
        </div>
      </header>

      <!-- MDX Article Body -->
      <article class="prose prose-portfolio max-w-none rounded-card border border-border bg-card p-8 sm:p-12">
        <Content />
      </article>

    </Container>
  </main>

  <Footer />
</BaseLayout>
