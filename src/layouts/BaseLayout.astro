---
import '@/styles/global.css';
import { siteConfig } from '@/data/site';
import { CommandPalette } from '@/components/interactive/CommandPalette';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = siteConfig.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ashankavinda.dev');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  description: siteConfig.bio,
  url: canonicalURL.toString(),
  sameAs: [
    'https://github.com/Ashankavinda277',
    'https://linkedin.com/in/ashan-kavinda'
  ],
  knowsAbout: [
    'React',
    'Next.js',
    'TypeScript',
    'Python',
    'FastAPI',
    'AWS Cloud Architecture',
    'Software Engineering'
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Applies the stored theme before first paint. Light is the default, so
         it is the absence of a class; only an explicit toggle persists a choice. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.style.colorScheme = theme;

        // Gates the reveal animations' hidden starting state. Set here, before
        // paint, so animated elements never flash in first. Left off entirely
        // when motion is reduced, which keeps that content plainly visible.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('anim');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-accent selection:text-accent-foreground flex flex-col font-sans">
    <slot />

    <!-- Global Client Islands -->
    <CommandPalette client:idle />

    <script>
      import { installMailtoInterceptor } from '@/lib/openMail';
      import { initAnimations } from '@/lib/animations';

      installMailtoInterceptor();
      initAnimations();
    </script>
  </body>
</html>
