---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { ArrowLeft, ExternalLink } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  category: string;
  year: string | number;
  image?: string | undefined;
  github?: string | undefined;
  demo?: string | undefined;
}

const {
  title,
  description,
  technologies,
  category,
  year,
  image,
  github,
  demo,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <main class="flex-1 py-12 sm:py-16">
    <Container size="md" class="space-y-10">
      <!-- Back Link -->
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors group"
      >
        <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
        <span>Back to all projects</span>
      </a>

      <!-- Case Study Header -->
      <header class="space-y-6">
        <div class="flex items-center gap-3">
          <Badge variant="accent">{category}</Badge>
          <span class="font-mono text-xs text-muted-foreground">{year}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-tight">
          {title}
        </h1>

        <p class="text-base sm:text-xl text-muted-foreground leading-relaxed">
          {description}
        </p>

        <!-- Technology Badges -->
        <div class="flex flex-wrap gap-2 pt-2">
          {technologies.map((tech) => (
            <Badge variant="default" class="text-xs px-3 py-1">
              {tech}
            </Badge>
          ))}
        </div>

        <!-- Project Links (GitHub / Live Demo) -->
        {(github || demo) && (
          <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-border/40">
            {demo && (
              <Button href={demo} target="_blank" variant="primary" size="md">
                <span>Live Demo</span>
                <ExternalLink className="w-4 h-4" />
              </Button>
            )}
            {github && (
              <Button href={github} target="_blank" variant="outline" size="md" class="font-mono">
                <svg class="w-4 h-4 fill-current mr-1" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span>Source Code</span>
              </Button>
            )}
          </div>
        )}
      </header>

      <!-- Hero Image -->
      {image && (
        <div class="rounded-xl overflow-hidden border border-border/60 bg-muted/30 shadow-md">
          <img
            src={image}
            alt={title}
            class="w-full max-h-[450px] object-cover object-top"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80';"
          />
        </div>
      )}

      <!-- MDX Formatted Content Body -->
      <div class="pt-6 border-t border-border/40 space-y-6 text-foreground font-sans leading-relaxed text-base [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:tracking-tight [&>h2]:text-foreground [&>h2]:pt-6 [&>h2]:pb-2 [&>h3]:text-lg [&>h3]:font-semibold [&>h3]:text-foreground [&>h3]:pt-4 [&>p]:text-muted-foreground [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ul]:text-muted-foreground [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 [&>ol]:text-muted-foreground [&>blockquote]:border-l-2 [&>blockquote]:border-accent [&>blockquote]:pl-4 [&>blockquote]:italic [&>code]:font-mono [&>code]:bg-muted/80 [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:rounded [&>code]:text-xs">
        <slot />
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
