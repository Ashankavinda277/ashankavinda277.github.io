---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import { ArrowLeft, ExternalLink } from 'lucide-react';
import { normalizeRepos, type GithubField } from '@/lib/repos';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  category: string;
  year: string | number;
  image?: string | undefined;
  github?: GithubField;
  demo?: string | undefined;
}

const {
  title,
  description,
  technologies,
  category,
  year,
  image,
  github,
  demo,
} = Astro.props;

// A lone repo keeps its original "Source Code" wording; several are named
// individually so the reader can tell the client from the service.
const repos = normalizeRepos(github);
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <main class="relative flex-1 py-12 sm:py-16">
    <AmbientGlow />
    <Container size="md" class="relative space-y-10">
      <!-- Back Link -->
      <a
        data-reveal
        data-reveal-now
        href="/projects"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
      >
        <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
        <span>Back to all projects</span>
      </a>

      <!-- Case Study Header -->
      <header data-stagger class="space-y-6">
        <div data-reveal class="flex items-center gap-3">
          <Badge>{category}</Badge>
          <span class="text-sm text-muted-foreground">{year}</span>
        </div>

        <h1 data-reveal class="text-3xl sm:text-5xl font-semibold tracking-tight text-foreground leading-tight">
          {title}
        </h1>

        <p data-reveal class="text-base sm:text-xl text-muted-foreground leading-relaxed">
          {description}
        </p>

        <!-- Technology Badges -->
        <div data-reveal class="flex flex-wrap gap-2 pt-2">
          {technologies.map((tech) => (
            <Badge variant="default" class="text-xs px-3 py-1">
              {tech}
            </Badge>
          ))}
        </div>

        <!-- Project Links (GitHub / Live Demo) -->
        {(repos.length > 0 || demo) && (
          <div data-reveal class="flex flex-wrap items-center gap-4 pt-4 border-t border-border">
            {demo && (
              <Button href={demo} target="_blank" variant="primary" size="md">
                <span>Live Demo</span>
                <ExternalLink className="w-4 h-4" />
              </Button>
            )}
            {repos.map((repo) => (
              <Button href={repo.url} target="_blank" variant="secondary" size="md">
                <svg class="w-4 h-4 fill-current mr-1" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span>{repo.label}</span>
              </Button>
            ))}
          </div>
        )}
      </header>

      <!-- Hero Image -->
      {image && (
        <div data-reveal="zoom" class="overflow-hidden rounded-card border border-border bg-muted shadow-overlay">
          <img
            src={image}
            alt={title}
            class="w-full max-h-[450px] object-cover object-top"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80';"
          />
        </div>
      )}

      <!-- MDX Formatted Content Body -->
      <div class="prose prose-portfolio max-w-none border-t border-border pt-6">
        <slot />
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
