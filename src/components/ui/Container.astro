---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'full';
}

const { class: className = '', size = 'lg' } = Astro.props;

const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  full: 'max-w-7xl',
};
---

<div class={`w-full mx-auto px-4 sm:px-6 lg:px-8 ${sizes[size]} ${className}`}>
  <slot />
</div>
