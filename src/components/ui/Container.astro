---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'full' | 'wide';
  [key: string]: any;
}

const { class: className = '', size = 'full', ...rest } = Astro.props;


const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-[1152px]',
  lg: 'max-w-[1280px]',
  full: 'max-w-[1200px]',
  wide: 'max-w-[1536px]',
};

---

<div class={`w-full mx-auto px-5 sm:px-6 lg:px-8 ${sizes[size]} ${className}`} {...rest}>
  <slot />
</div>
