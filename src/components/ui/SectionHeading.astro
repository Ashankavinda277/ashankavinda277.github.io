---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  class?: string;
}

const { kicker, title, description, class: className = '' } = Astro.props;
---

<div class={`space-y-2 ${className}`}>
  {kicker && (
    <p class="text-xs font-mono font-semibold tracking-wider text-accent uppercase">
      {kicker}
    </p>
  )}
  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
    {title}
  </h2>
  {description && (
    <p class="text-sm sm:text-base text-muted-foreground max-w-2xl leading-relaxed">
      {description}
    </p>
  )}
</div>
