---
/**
 * Page-title heading for /projects and /blog. Echoes SectionMarker's
 * tracked-kicker-plus-hairline device (the site's one typographic signature)
 * so sub-pages read as the same design system as the home page, not a
 * separate, plainer one.
 */
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  class?: string;
  align?: 'left' | 'center';
}

const { kicker, title, description, class: className = '', align = 'left' } = Astro.props;

const alignClasses = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

{/*
  The kicker was an accent-coloured label. With no accent hue left, the
  emphasis moves to the typeface: mono, smaller, uppercase, widely tracked,
  and dimmed to --muted-foreground. That reads as deliberate metadata rather
  than as washed-out heading text, which is what a coloured label was doing
  before.
*/}
<div data-stagger class={`flex flex-col ${alignClasses} gap-4 ${className}`}>
  {kicker && (
    <div class={`flex items-center gap-4 ${align === 'center' ? 'w-full max-w-xs' : 'w-full'}`}>
      {align !== 'center' && <span data-reveal class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">{kicker}</span>}
      <span data-reveal="rule" class="h-px flex-1 bg-border" aria-hidden="true"></span>
      {align === 'center' && <span data-reveal class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">{kicker}</span>}
      <span data-reveal="rule" class="h-px flex-1 bg-border" aria-hidden="true"></span>
    </div>
  )}

  <h2 data-reveal class="text-3xl sm:text-4xl font-semibold tracking-tight text-foreground">
    {title}
  </h2>

  {description && (
    <p data-reveal class="max-w-2xl text-base leading-relaxed text-muted-foreground">
      {description}
    </p>
  )}
</div>
