---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  class?: string;
  align?: 'left' | 'center';
}

const { kicker, title, description, class: className = '', align = 'left' } = Astro.props;

const alignClasses = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col ${alignClasses} gap-3 ${className}`}>
  {kicker && <span class="text-sm font-medium text-muted-foreground">{kicker}</span>}

  <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-foreground">
    {title}
  </h2>

  {description && (
    <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
      {description}
    </p>
  )}
</div>
