---
import { buttonClass, type ButtonVariant, type ButtonSize } from './buttonStyles';

interface Props {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
  type,
  disabled,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={target === '_blank' && !rel ? 'noopener noreferrer' : rel}
  type={href ? undefined : (type ?? 'button')}
  disabled={href ? undefined : disabled}
  class={buttonClass({ variant, size, className })}
  {...rest}
>
  <slot />
</Tag>
