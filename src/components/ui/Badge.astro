---
interface Props {
  variant?: 'default' | 'outline' | 'accent';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default: 'bg-muted text-foreground/90 border border-border/60 font-mono',
  outline: 'bg-transparent text-muted-foreground border border-border font-mono',
  accent: 'bg-accent-muted text-accent border border-accent/20 font-mono font-medium',
};
---

<span class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs transition-colors ${variants[variant]} ${className}`}>
  <slot />
</span>
