---
import Container from '@/components/ui/Container.astro';
import { siteConfig } from '@/data/site';
import { navItems } from '@/data/navigation';
import { NavbarInteractive } from './NavbarInteractive';
---

<header
  data-reveal="down"
  data-reveal-now
  class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-xl"
>
  <Container size="full" class="h-16 flex items-center justify-between">

    <!-- Brand -->
    <a
      href="/"
      class="text-base font-semibold tracking-tight text-foreground transition-colors hover:text-foreground/80"
      aria-label={`${siteConfig.name} - Home`}
    >
      {siteConfig.name}
    </a>

    <!-- Desktop Navigation Items -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="desktop-nav-link link-underline py-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Interactive Client Widget (Command Palette & Mobile Menu) -->
    <NavbarInteractive client:load navItems={navItems} />
  </Container>
</header>

<script>
  function markActive(links: NodeListOf<Element>, activeHref: string | null) {
    links.forEach((link) => {
      const isActive = link.getAttribute('href') === activeHref;
      link.classList.toggle('text-link', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-muted-foreground', !isActive);
    });
  }

  function setupActiveNav() {
    const navLinks = document.querySelectorAll('.desktop-nav-link');
    if (!navLinks.length) return;

    // Sub-pages have no scrollable sections; highlight by pathname instead.
    const { pathname } = window.location;
    if (pathname.startsWith('/projects')) return markActive(navLinks, '/#projects');
    if (pathname.startsWith('/blog')) return markActive(navLinks, '/#articles');

    // Map each in-page nav target to its section element.
    const sections = new Map<Element, string>();
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const hashIndex = href?.indexOf('#') ?? -1;
      if (!href || hashIndex === -1) return;
      const target = document.querySelector(href.slice(hashIndex));
      if (target) sections.set(target, href);
    });
    if (!sections.size) return;

    // offsetTop drifts because sections sit inside a flex <main>, so observe
    // instead: a band across the viewport middle decides what counts as active.
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        });

        // With several sections in the band, prefer the topmost.
        const current = [...sections.keys()].find((el) => visible.has(el));
        markActive(navLinks, current ? (sections.get(current) ?? null) : null);
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );

    sections.forEach((_href, el) => observer.observe(el));
  }

  setupActiveNav();
  document.addEventListener('astro:page-load', setupActiveNav);
</script>
