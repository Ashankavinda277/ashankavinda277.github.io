---
import Container from '@/components/ui/Container.astro';
import { siteConfig } from '@/data/site';
import { socialLinks } from '@/data/social';
import { Mail } from 'lucide-react';
---

<footer class="border-t border-blue-500/10 py-12 bg-[#030612] mt-auto">
  <Container size="full" class="flex flex-col md:flex-row items-center justify-between gap-6">

    <!-- Brand Tagline -->
    <div class="space-y-1 text-center md:text-left">
      <p class="font-mono font-bold text-sm tracking-tight text-slate-100 flex items-center justify-center md:justify-start gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400 inline-block shadow-[0_0_8px_#3b82f6]"></span>
        {siteConfig.name}
      </p>
      <p class="text-xs font-mono text-slate-400">
        {siteConfig.role} — Developer Workspace
      </p>
    </div>

    <!-- Social Media Links -->
    <div class="flex items-center gap-4">
      {socialLinks.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('http') ? '_blank' : '_self'}
          rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="w-9 h-9 flex items-center justify-center rounded-xl border border-slate-800 bg-[#070b21]/90 hover:border-blue-500/50 hover:text-blue-400 text-slate-400 transition-all duration-200"
          aria-label={link.name}
          title={link.name}
        >
          {link.iconName === 'github' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          )}
          {link.iconName === 'linkedin' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26z"/>
            </svg>
          )}
          {(link.iconName === 'mail' || link.iconName === 'email') && <Mail className="w-4 h-4" />}
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="text-xs font-mono text-slate-400 text-center md:text-right">
      © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
    </p>
  </Container>
</footer>
