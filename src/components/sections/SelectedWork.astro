---
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { ArrowRight } from 'lucide-react';

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<section id="projects" class="py-20 lg:py-28 border-b border-blue-500/10 scroll-mt-16 relative bg-[#040717]">
  <Container size="full" class="space-y-12">

    <!-- Header with Section Title -->
    <SectionHeading
      kicker="FEATURED PROJECTS"
      title="Selected Work"
      description="A selection of recent applications built with modern frontend, backend, and cloud architectures."
      align="center"
    />

    <!-- Project Cards Grid -->
    {featuredProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            shortDescription={project.data.shortDescription}
            technologies={project.data.technologies}
            category={project.data.category}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            image={project.data.image}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 text-center rounded-2xl border border-slate-800 bg-[#070b21] text-slate-400 font-mono text-sm">
        No featured projects currently listed.
      </div>
    )}

    <!-- View All Projects Button (Placed Under Project Cards) -->
    <div class="flex justify-center pt-6">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs uppercase tracking-wider font-bold shadow-lg shadow-blue-600/30 transition-all duration-200 hover:scale-[1.02] group"
      >
        <span>View All Projects</span>
        <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </Container>
</section>
