---
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { ProjectCard } from '@/components/projects/ProjectCard';
import { ArrowRight } from 'lucide-react';

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<section id="projects" class="scroll-mt-16 border-t border-border py-20 sm:py-28">
  <Container size="full" class="space-y-14">

    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        kicker="Work"
        title="Selected Work"
        description="A selection of recent applications built with modern frontend, backend, and cloud architectures."
      />

      <Button href="/projects" variant="secondary" size="sm" class="shrink-0">
        <span>View All Projects</span>
        <ArrowRight className="w-4 h-4" />
      </Button>
    </div>

    <!-- Rendered without a client directive: static HTML, zero JS shipped. -->
    {featuredProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            shortDescription={project.data.shortDescription}
            technologies={project.data.technologies}
            category={project.data.category}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            image={project.data.image}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-card border border-border bg-card p-8 text-center text-sm text-muted-foreground">
        No featured projects currently listed.
      </div>
    )}

  </Container>
</section>
