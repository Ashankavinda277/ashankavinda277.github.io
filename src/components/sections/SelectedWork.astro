---
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionMarker from '@/components/ui/SectionMarker.astro';
import Button from '@/components/ui/Button.astro';
import { ProjectCard } from '@/components/projects/ProjectCard';
import { ArrowRight } from 'lucide-react';

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<section id="projects" class="scroll-mt-16 py-24 sm:py-32">
  <Container size="full" class="space-y-12">

    <SectionMarker number="02" label="Selected Work" />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-2xl font-semibold leading-snug tracking-tight text-foreground sm:text-3xl lg:col-span-8">
        Applications built with modern frontend, backend, and cloud architectures.
      </h2>

      <div class="lg:col-span-4 lg:justify-self-end">
        <Button href="/projects" variant="secondary" size="sm">
          <span>View All Projects</span>
          <ArrowRight className="w-4 h-4" />
        </Button>
      </div>
    </div>

    <!-- Rendered without a client directive: static HTML, zero JS shipped. -->
    {featuredProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            shortDescription={project.data.shortDescription}
            technologies={project.data.technologies}
            category={project.data.category}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            image={project.data.image}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-card border border-border bg-card p-8 text-center text-sm text-muted-foreground">
        No featured projects currently listed.
      </div>
    )}

  </Container>
</section>
