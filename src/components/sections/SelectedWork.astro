---
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import { ArrowRight } from 'lucide-react';

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<section id="projects" class="py-20 lg:py-28 border-b border-border/40 scroll-mt-16 relative">
  <Container size="full" class="space-y-16">

    <!-- Header with Section Title and View All Button -->
    <div class="flex flex-col items-center text-center space-y-4">
      <SectionHeading
        kicker="FEATURED PROJECTS"
        title="Selected Work"
        description="A selection of recent applications built with modern frontend, backend, and cloud architectures."
        align="center"
      />

      <Button href="/projects" variant="outline" size="sm" class="font-mono text-xs border-blue-900/50 hover:border-blue-500/50 hover:bg-blue-500/10">
        <span>View All Projects</span>
        <ArrowRight className="w-3.5 h-3.5 ml-1" />
      </Button>
    </div>


    <!-- Project Cards Grid -->
    {featuredProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            shortDescription={project.data.shortDescription}
            technologies={project.data.technologies}
            category={project.data.category}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            image={project.data.image}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 text-center rounded-2xl border border-blue-900/40 bg-card/40 text-muted-foreground font-mono text-sm">
        No featured projects currently listed.
      </div>
    )}
  </Container>
</section>
