---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { skillCategories } from '@/data/skills';
import { SkillsMotion } from '@/components/interactive/SkillsMotion';
---

<section id="skills" class="py-16 sm:py-24 border-b border-border/40 scroll-mt-16">
  <Container size="full" class="space-y-12">

    <SectionHeading
      kicker="Technical Stack"
      title="Skills & Technologies"
      description="A structured overview of core programming languages, frameworks, cloud services, and developer tools."
    />

    <SkillsMotion client:visible categories={skillCategories} />
  </Container>
</section>
