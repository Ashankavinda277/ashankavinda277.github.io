---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { SkillsCarousel } from '@/components/interactive/SkillsCarousel';
import { skillCategories } from '@/data/skills';
---

<section id="skills" class="scroll-mt-16 border-t border-border bg-surface py-20 sm:py-28">
  <Container size="full" class="space-y-14">

    <SectionHeading
      kicker="Stack"
      title="Skills & Technologies"
      description="A structured overview of core programming languages, frameworks, cloud services, and developer tools."
    />

    <SkillsCarousel categories={skillCategories} client:visible />

  </Container>
</section>
