---
import Container from '@/components/ui/Container.astro';
import SectionMarker from '@/components/ui/SectionMarker.astro';
import { SkillsCarousel } from '@/components/interactive/SkillsCarousel';
import { skillCategories } from '@/data/skills';
---

<section id="skills" class="scroll-mt-16 py-24 sm:py-32">
  <Container size="full" class="space-y-12">

    <SectionMarker number="03" label="Skills" />

    <h2 class="max-w-3xl text-2xl font-semibold leading-snug tracking-tight text-foreground sm:text-3xl">
      Core languages, frameworks, cloud services, and developer tools.
    </h2>

    <SkillsCarousel categories={skillCategories} client:visible />

  </Container>
</section>
