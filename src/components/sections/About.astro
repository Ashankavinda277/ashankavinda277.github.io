---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { journeyTimeline } from '@/data/journey';
import { Code, Cloud, Cpu, FileText, GraduationCap, Briefcase, Loader2 } from 'lucide-react';
---

<section id="about" class="py-20 lg:py-28 border-b border-cyan-500/10 scroll-mt-16 relative bg-cyber-network">
  <Container size="full" class="space-y-16">

    <SectionHeading
      kicker="BACKGROUND & PHILOSOPHY"
      title="About Me"
      description="An undergraduate IT student focused on building clean, type-safe, and scalable web platforms."
      align="center"
    />

    <!-- Main About Hub Grid (12 Columns: Left Narrative, Right Journey Timeline) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Narrative & Core Philosophy (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between p-8 sm:p-10 rounded-3xl cyber-glass-card space-y-6">
        <div class="space-y-4">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-100 leading-snug">
            I build <span class="text-gradient-cyan-purple">reliable full-stack web platforms</span> and cloud-native backends.
          </h3>

          <p class="text-slate-300 leading-relaxed text-base">
            My development journey centers on practical software engineering. Rather than claiming expert status across every tool, I focus on mastering core computer science concepts, writing clean type-safe code, and building systems that solve operational problems.
          </p>

          <p class="text-slate-300 leading-relaxed text-base">
            I work primarily with <strong class="text-cyan-400 font-semibold">React, Next.js, TypeScript, and Python (FastAPI)</strong> on the application layer, alongside <strong class="text-purple-400 font-semibold">AWS cloud services</strong> (Amplify, AppSync, DynamoDB, Cognito) for backend infrastructure.
          </p>
        </div>

        <div class="pt-4 flex items-center gap-4 border-t border-cyan-500/20">
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-cyber-primary font-semibold px-6 py-3 rounded-xl flex items-center gap-2 text-sm"
          >
            <FileText className="w-4 h-4" />
            <span>Download Resume (PDF)</span>
          </a>
        </div>
      </div>

      <!-- Right Column: My Journey Timeline (7 Cols - Replaces Code Snippet) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="flex items-center justify-between border-b border-cyan-500/20 pb-4">
          <div>
            <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest block">
              CAREER & EDUCATION
            </span>
            <h3 class="text-2xl font-bold text-slate-100">
              My <span class="text-gradient-cyan-purple">Journey</span>
            </h3>
          </div>
          <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">
            Timeline
          </span>
        </div>

        <div class="relative pl-6 sm:pl-8 border-l-2 border-cyan-500/30 space-y-6">
          {journeyTimeline.map((item, idx) => {
            const isPending = item.status === 'pending';
            return (
              <div class="relative group">
                {isPending ? (
                  <>
                    <!-- Skeleton Timeline Node Spinner -->
                    <div class="absolute -left-[31px] sm:-left-[39px] top-1 w-8 h-8 rounded-full bg-slate-950 border-2 border-amber-400 text-amber-400 flex items-center justify-center shadow-[0_0_15px_#f59e0b]">
                      <Loader2 className="w-4 h-4 animate-spin text-amber-400" />
                    </div>

                    <!-- Empty Loading Skeleton Card Body -->
                    <div class="p-5 sm:p-6 rounded-2xl border border-dashed border-amber-500/40 bg-amber-950/10 shadow-xl space-y-3 relative overflow-hidden backdrop-blur-sm">
                      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/20 pb-2">
                        <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">
                          Next Milestone
                        </span>
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[10px] font-mono font-semibold">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
                          <span>Loading Next Chapter...</span>
                        </div>
                      </div>

                      <!-- Skeleton Content Lines -->
                      <div class="space-y-2 pt-1">
                        <div class="h-4 w-2/3 bg-slate-800/80 rounded animate-pulse"></div>
                        <div class="h-3.5 w-full bg-slate-800/40 rounded animate-pulse"></div>
                        <div class="h-3.5 w-4/5 bg-slate-800/30 rounded animate-pulse"></div>
                      </div>

                      <!-- Skeleton Tag Pills -->
                      <div class="flex flex-wrap gap-1.5 pt-1">
                        <div class="h-5 w-16 bg-slate-900 border border-amber-500/20 rounded-full animate-pulse"></div>
                        <div class="h-5 w-20 bg-slate-900 border border-amber-500/20 rounded-full animate-pulse"></div>
                        <div class="h-5 w-14 bg-slate-900 border border-amber-500/20 rounded-full animate-pulse"></div>
                      </div>
                    </div>
                  </>
                ) : (
                  <>
                    <!-- Standard Timeline Node Icon -->
                    <div class="absolute -left-[31px] sm:-left-[39px] top-1 w-8 h-8 rounded-full bg-slate-950 border-2 border-cyan-400 text-cyan-300 flex items-center justify-center shadow-[0_0_15px_#00f0ff] group-hover:scale-110 transition-transform duration-200">
                      {idx === 0 ? <GraduationCap className="w-4 h-4" /> : <Briefcase className="w-4 h-4" />}
                    </div>

                    <!-- Card Content -->
                    <div class="p-5 sm:p-6 rounded-2xl cyber-glass-card hover:border-cyan-400/50 transition-all duration-300 space-y-2.5 shadow-xl">
                      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-cyan-500/15 pb-2">
                        <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
                          {item.year}
                        </span>
                        
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-mono text-slate-400">
                            {item.organization}
                          </span>
                          <span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-[10px] font-mono font-semibold">
                            In Progress
                          </span>
                        </div>
                      </div>

                      <h4 class="text-lg font-bold text-slate-100">
                        {item.role}
                      </h4>

                      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                        {item.description}
                      </p>

                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {item.skills.map((skill) => (
                          <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-slate-900 text-cyan-300 border border-cyan-500/30">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  </>
                )}
              </div>
            );
          })}
        </div>
      </div>

    </div>

    <!-- Engineering Focus Cards (3 Grid Items) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-400 w-fit border border-cyan-500/30">
          <Code className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">Full-Stack Development</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Type-safe React and Next.js interfaces paired with FastAPI or serverless GraphQL API handlers.
        </p>
      </div>

      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-purple-500/10 text-purple-400 w-fit border border-purple-500/30">
          <Cloud className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">AWS Cloud Infrastructure</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Amplify Gen 2 serverless platforms, AppSync GraphQL, DynamoDB single-table models, and Cognito auth.
        </p>
      </div>

      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-300 w-fit border border-cyan-500/30">
          <Cpu className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">Practical AI Integration</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Integrating Amazon Bedrock Action Groups, Claude models, and automated reporting workflows into web apps.
        </p>
      </div>

    </div>

  </Container>
</section>



