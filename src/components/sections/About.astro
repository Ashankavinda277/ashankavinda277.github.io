---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { Code, Cloud, Cpu, FileText, Terminal } from 'lucide-react';
---

<section id="about" class="py-20 lg:py-28 border-b border-cyan-500/10 scroll-mt-16 relative bg-cyber-network">
  <Container size="lg" class="space-y-16">
    
    <SectionHeading
      kicker="BACKGROUND & PHILOSOPHY"
      title="About Me"
      description="An undergraduate IT student focused on building clean, type-safe, and scalable web platforms."
      align="center"
    />

    <!-- Bento Architecture Hub Grid (12 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Bento Tile 1: Narrative & Core Philosophy (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between p-8 sm:p-10 rounded-3xl cyber-glass-card space-y-6">
        <div class="space-y-4">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-100 leading-snug">
            I build <span class="text-gradient-cyan-purple">reliable full-stack web platforms</span> and cloud-native backends.
          </h3>

          <p class="text-slate-300 leading-relaxed text-base sm:text-lg">
            My development journey centers on practical software engineering. Rather than claiming expert status across every tool, I focus on mastering core computer science concepts, writing clean type-safe code, and building systems that solve operational problems.
          </p>

          <p class="text-slate-300 leading-relaxed text-base sm:text-lg">
            I work primarily with <strong class="text-cyan-400 font-semibold">React, Next.js, TypeScript, and Python (FastAPI)</strong> on the application layer, alongside <strong class="text-purple-400 font-semibold">AWS cloud services</strong> (Amplify, AppSync, DynamoDB, Cognito) for backend infrastructure.
          </p>
        </div>

        <div class="pt-4 flex items-center gap-4 border-t border-cyan-500/20">
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-cyber-primary font-semibold px-6 py-3 rounded-xl flex items-center gap-2 text-sm"
          >
            <FileText className="w-4 h-4" />
            <span>Download Resume (PDF)</span>
          </a>
        </div>
      </div>

      <!-- Bento Tile 2: Live Architecture Code Snippet (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between p-6 sm:p-8 rounded-3xl border border-purple-500/30 bg-[#090d24]/90 shadow-2xl space-y-4 font-mono text-xs">
        
        <!-- Window Controls Header -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          </div>
          <span class="text-[11px] text-slate-400 flex items-center gap-1.5">
            <Terminal className="w-3.5 h-3.5 text-cyan-400" />
            <span>architecture_pattern.py</span>
          </span>
        </div>

        <!-- Code Block -->
        <pre class="overflow-x-auto text-slate-300 leading-relaxed space-y-1 p-2">
<span class="text-purple-400"># Cloud System Architecture</span>
<span class="text-cyan-400">from</span> fastapi <span class="text-cyan-400">import</span> FastAPI, Depends
<span class="text-cyan-400">from</span> bedrock_agent <span class="text-cyan-400">import</span> BedrockClient

app = FastAPI(title=<span class="text-emerald-400">"HRMS AI Engine"</span>)

<span class="text-purple-400">@app.get</span>(<span class="text-emerald-400">"/api/v1/analytics"</span>)
<span class="text-cyan-400">async def</span> <span class="text-cyan-300">get_summary</span>(
    dept_id: str, 
    client: BedrockClient = Depends()
):
    data = <span class="text-cyan-400">await</span> client.query(dept_id)
    <span class="text-cyan-400">return</span> &#123;<span class="text-emerald-400">"status"</span>: <span class="text-amber-400">200</span>, <span class="text-emerald-400">"metrics"</span>: data&#125;
        </pre>

        <!-- Footer Tag -->
        <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
          <span class="text-cyan-400 font-semibold">● FastAPI + AWS Amplify</span>
          <span>UTF-8</span>
        </div>

      </div>

    </div>

    <!-- Bottom Engineering Focus Cards (3 Grid Items) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-400 w-fit border border-cyan-500/30">
          <Code className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">Full-Stack Development</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Type-safe React and Next.js interfaces paired with FastAPI or serverless GraphQL API handlers.
        </p>
      </div>

      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-purple-500/10 text-purple-400 w-fit border border-purple-500/30">
          <Cloud className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">AWS Cloud Infrastructure</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Amplify Gen 2 serverless platforms, AppSync GraphQL, DynamoDB single-table models, and Cognito auth.
        </p>
      </div>

      <div class="p-6 rounded-2xl cyber-glass-card space-y-3">
        <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-300 w-fit border border-cyan-500/30">
          <Cpu className="w-5 h-5" />
        </div>
        <h4 class="text-lg font-bold text-slate-100">Practical AI Integration</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Integrating Amazon Bedrock Action Groups, Claude models, and automated reporting workflows into web apps.
        </p>
      </div>

    </div>

  </Container>
</section>

