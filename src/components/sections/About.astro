---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/data/site';
import { Terminal, Code, Cpu, Cloud } from 'lucide-react';
---

<section id="about" class="py-16 sm:py-24 border-b border-border/40 scroll-mt-16 bg-muted/10">
  <Container size="lg" class="space-y-12">
    <SectionHeading
      kicker="Background & Philosophy"
      title="About Me"
      description="An undergraduate IT student focused on building practical, scalable web and cloud software."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Narrative Text Column -->
      <div class="lg:col-span-7 space-y-6 text-muted-foreground leading-relaxed text-base sm:text-lg">
        <p class="text-foreground font-medium text-lg sm:text-xl">
          Hi, I'm <span class="text-accent font-semibold">{siteConfig.name}</span>. I'm currently an Information Technology undergraduate with a deep passion for building full-stack applications and cloud-backed software.
        </p>

        <p>
          My development journey centers on practical software engineering. Rather than trying to claim expert status across every tool, I focus on understanding fundamental concepts, writing clean type-safe code, and building systems that solve real operational problems.
        </p>

        <p>
          I work primarily with <strong class="text-foreground font-semibold">React, Next.js, TypeScript, and Python (FastAPI)</strong> on the software layer, alongside <strong class="text-foreground font-semibold">AWS cloud services</strong> (Amplify, AppSync, DynamoDB, Cognito) for backend infrastructure. Recently, I've been actively exploring <strong class="text-foreground font-semibold">AI integration with Amazon Bedrock</strong> to bring intelligent automation to web tools.
        </p>

        <p>
          When I'm not writing code for coursework or personal projects, I enjoy reading technical documentation, learning modern system architecture patterns, and refining my development workspace.
        </p>
      </div>

      <!-- Right Focus Highlights Card Column -->
      <div class="lg:col-span-5 space-y-4">
        <div class="rounded-xl border border-border/70 bg-card p-6 sm:p-8 space-y-6 shadow-sm">
          <h3 class="font-mono font-bold text-sm uppercase tracking-wider text-foreground flex items-center gap-2 border-b border-border/50 pb-4">
            <Terminal className="w-4 h-4 text-accent" />
            <span>Core Focus Areas</span>
          </h3>

          <ul class="space-y-4 text-xs sm:text-sm font-mono text-muted-foreground">
            <li class="flex items-start gap-3">
              <Code className="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <strong class="text-foreground block font-sans font-semibold text-sm">Full-Stack Development</strong>
                <span>Type-safe frontend React/Next.js interfaces paired with FastAPI or serverless backends.</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <Cloud className="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <strong class="text-foreground block font-sans font-semibold text-sm">Cloud Infrastructure</strong>
                <span>AWS serverless services (Amplify, AppSync, DynamoDB, Cognito authentication).</span>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <Cpu className="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <strong class="text-foreground block font-sans font-semibold text-sm">Practical AI & Automation</strong>
                <span>Integrating LLM APIs and intelligent processing workflows into web applications.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
