---
import Container from '@/components/ui/Container.astro';
import SectionMarker from '@/components/ui/SectionMarker.astro';
import Button from '@/components/ui/Button.astro';
import { journeyTimeline } from '@/data/journey';
import { Code, Cloud, Cpu, FileText } from 'lucide-react';

const focusAreas = [
  {
    icon: Code,
    title: 'Full-Stack Development',
    description:
      'Type-safe React and Next.js interfaces paired with FastAPI or serverless GraphQL API handlers.',
  },
  {
    icon: Cloud,
    title: 'AWS Cloud Infrastructure',
    description:
      'Amplify Gen 2 serverless platforms, AppSync GraphQL, DynamoDB single-table models, and Cognito auth.',
  },
  {
    icon: Cpu,
    title: 'Practical AI Integration',
    description:
      'Integrating Amazon Bedrock Action Groups, Claude models, and automated reporting workflows into web apps.',
  },
];
---

<section id="about" class="scroll-mt-16 bg-surface py-24 sm:py-32">
  <Container size="full" class="space-y-12">

    <SectionMarker number="01" label="About" />

    <div data-stagger class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">

      <!-- Left Column: Narrative -->
      <div data-reveal class="lg:col-span-7 space-y-6">
        <h2 class="text-2xl font-semibold leading-snug tracking-tight text-foreground sm:text-3xl">
          A developer who enjoys turning ideas into real-world solutions
        </h2>

        <p class="text-base leading-relaxed text-muted-foreground">
          I'm a 3rd-year Information Technology undergraduate with a growing passion for software
          development and building practical solutions to real-world problems. I enjoy turning ideas
          into working applications, solving problems through logical thinking, and approaching
          challenges with creativity.
        </p>

        <p class="text-base leading-relaxed text-muted-foreground">
          Beyond my academic journey, I'm exploring Artificial Intelligence, Cloud Solutions, DevOps,
          and emerging technologies to expand my understanding of modern software engineering. I'm
          always looking for opportunities to experiment, learn something new, and apply what I learn
          through hands-on projects.
        </p>

        <p class="text-base leading-relaxed text-muted-foreground">
          For me, development is a continuous journey of learning, building, and improving. I believe
          that every project is an opportunity to solve a problem, gain new knowledge, and become a
          better developer.
        </p>

        <div class="border-t border-border pt-6">
          <Button
            href="/resume.pdf"
            target="_blank"
            variant="primary"
            size="lg"
            class="btn-glow group"
          >
            <FileText className="w-4 h-4 transition-transform duration-300 group-hover:-translate-y-0.5" />
            <span>Download Resume (PDF)</span>
          </Button>
        </div>
      </div>

      <!-- Right Column: Journey Timeline -->
      <div data-reveal class="lg:col-span-5 space-y-6">
        <h3 class="text-xl font-semibold tracking-tight text-foreground">My Journey</h3>

        <ol class="relative space-y-8 border-l border-border pl-6">
          {journeyTimeline.map((item) => (
            <li class="relative">
              {item.status === 'pending' ? (
                <span class="absolute -left-[27px] top-2 flex h-2 w-2" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-foreground/60"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full border border-foreground bg-surface"></span>
                </span>
              ) : (
                <span
                  class="absolute -left-[27px] top-2 h-2 w-2 rounded-full bg-foreground"
                  aria-hidden="true"
                ></span>
              )}

              <p class="text-sm text-muted-foreground">{item.year}</p>
              <h4 class="mt-1 text-base font-semibold leading-snug text-foreground">
                {item.role}
              </h4>
              <p class="mt-1 text-sm text-muted-foreground">{item.organization}</p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {item.description}
              </p>
            </li>
          ))}
        </ol>
      </div>

    </div>

    <!-- Engineering Focus -->
    <div data-stagger class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {focusAreas.map((area) => (
        <div data-reveal class="card-tinted group space-y-3 rounded-card border border-border bg-card p-6 shadow-card transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-border-hover hover:shadow-card-lg">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-control bg-muted text-muted-foreground transition-colors duration-300 group-hover:text-foreground">
            <area.icon className="w-5 h-5" />
          </span>
          <h4 class="text-lg font-semibold text-foreground transition-colors duration-200 group-hover:text-foreground">{area.title}</h4>
          <p class="text-sm leading-relaxed text-muted-foreground">{area.description}</p>
        </div>
      ))}
    </div>

  </Container>
</section>
