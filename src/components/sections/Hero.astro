---
import Container from '@/components/ui/Container.astro';
import { siteConfig } from '@/data/site';
import { socialLinks } from '@/data/social';
import { ArrowDown, ArrowRight, Github, Linkedin, Mail, Download } from 'lucide-react';

---

<section class="relative min-h-[85vh] flex flex-col justify-center pt-24 pb-8 overflow-hidden bg-cyber-network border-b border-cyan-500/10">
  
  <!-- Cyber Node Circuit Background Overlay Lines & Glowing Dots -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0">
    <!-- SVG Network Grid Lines -->
    <svg class="absolute w-full h-full opacity-25" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-circuit-grid" width="120" height="120" patternUnits="userSpaceOnUse">
          <path d="M 120 0 L 0 0 0 120" fill="none" stroke="rgba(0, 240, 255, 0.12)" stroke-width="1.2" />
          <circle cx="120" cy="0" r="3" fill="#00f0ff" class="animate-pulse" />
          <circle cx="0" cy="120" r="3" fill="#a855f7" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-circuit-grid)" />
    </svg>

    <!-- Glowing Background Orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-cyan-500/10 rounded-full blur-[160px] pointer-events-none"></div>
    <div class="absolute top-2/3 right-10 w-[450px] h-[450px] bg-purple-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <!-- Glowing Node Dots inspired by Image 2 -->
    <div class="absolute top-[18%] right-[15%] w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_12px_#00f0ff]"></div>
    <div class="absolute top-[35%] right-[28%] w-2.5 h-2.5 rounded-full bg-purple-400 shadow-[0_0_14px_#a855f7]"></div>
    <div class="absolute bottom-[25%] right-[8%] w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_10px_#00f0ff]"></div>
    <div class="absolute top-[60%] left-[8%] w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_10px_#00f0ff]"></div>
  </div>

  <Container size="full" class="relative z-10 my-auto py-6 sm:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Text Content & Action Buttons (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Top Pill Badge (Exact Image 2 style: Available for opportunities) -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-mono text-xs shadow-[0_0_15px_rgba(0,240,255,0.15)]">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#00f0ff]"></span>
          <span>Available for opportunities</span>
        </div>

        <!-- Main Glowing Name Heading (Image 2 style) -->
        <div class="space-y-3">
          <h1 class="text-4xl sm:text-6xl lg:text-6xl xl:text-7xl font-black tracking-tight leading-[1.08]">
            <span class="text-slate-100">Hi, I'm </span>
            <span class="text-gradient-cyan-purple">{siteConfig.name}</span>
          </h1>

          <h2 class="text-xl sm:text-2xl lg:text-2xl xl:text-3xl font-bold text-slate-200 tracking-tight">
            Full-Stack Developer @ <span class="text-cyan-400 font-bold drop-shadow-[0_0_15px_rgba(0,240,255,0.4)]">University of Moratuwa</span>
          </h2>
        </div>

        <!-- Professional Bio -->
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl font-normal">
          {siteConfig.bio} Passionate about building type-safe web applications, scalable AWS cloud infrastructure, and AI-driven solutions.
        </p>

        <!-- Action Pill Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#projects"
            class="btn-cyber-primary font-semibold px-7 py-3 rounded-2xl flex items-center gap-2 text-xs sm:text-sm tracking-wide"
          >
            <span>View My Work</span>
            <ArrowRight className="w-4 h-4" />
          </a>

          <a
            href="#contact"
            class="btn-cyber-outline font-mono text-xs sm:text-sm px-7 py-3 rounded-2xl flex items-center gap-2"
          >
            <span>Get In Touch</span>
          </a>

          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-slate-400 hover:text-cyan-400 flex items-center gap-1.5 px-4 py-3 rounded-2xl border border-slate-800 hover:border-cyan-500/30 transition-all bg-slate-900/40"
          >
            <Download className="w-3.5 h-3.5 text-cyan-400" />
            <span>Resume (PDF)</span>
          </a>
        </div>

        <!-- Social Icons Row (Image 2 style) -->
        <div class="flex items-center gap-4 pt-3 font-mono text-xs text-slate-400">
          <span class="text-slate-500">Find me on</span>
          <div class="flex items-center gap-2.5">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/40 flex items-center justify-center text-slate-300 hover:text-cyan-400 transition-all group shadow-sm"
                aria-label={social.name}
              >
                {social.iconName === 'github' && <Github className="w-4 h-4 group-hover:drop-shadow-[0_0_8px_#00f0ff]" />}
                {social.iconName === 'linkedin' && <Linkedin className="w-4 h-4 group-hover:drop-shadow-[0_0_8px_#00f0ff]" />}
                {social.iconName === 'email' && <Mail className="w-4 h-4 group-hover:drop-shadow-[0_0_8px_#00f0ff]" />}
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Circular Glowing Profile Photo Frame (5 Cols - Matching Image 2) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end relative pt-4 lg:pt-0">
        <div class="relative group">
          <!-- Ambient Radial Background Glow -->
          <div class="absolute -inset-4 rounded-full bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 opacity-40 blur-2xl group-hover:opacity-75 transition duration-500"></div>

          <!-- Circular Outer Frame with Cyan Neon Ring -->
          <div class="relative w-56 h-56 sm:w-72 sm:h-72 lg:w-[320px] lg:h-[320px] xl:w-[360px] xl:h-[360px] rounded-full border-4 border-cyan-400 p-2 shadow-[0_0_45px_rgba(0,240,255,0.4)] bg-slate-950/90 backdrop-blur-md">
            <!-- Profile Photo Image -->
            <img
              src="/images/profile/avatar.jpeg"
              alt={siteConfig.name}
              class="w-full h-full object-cover rounded-full filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500"
              onerror="if (this.src.endsWith('.jpeg')) { this.src = '/images/profile/avatar.png'; } else if (this.src.endsWith('.png')) { this.src = '/images/profile/avatar.jpg'; } else { this.onerror = null; this.src = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80'; }"
            />

            <!-- Floating Status Badge (Image 2 style: ● Open to work) -->
            <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 z-20">
              <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-950/95 border border-cyan-500/50 text-cyan-300 font-mono text-xs shadow-[0_0_15px_rgba(0,240,255,0.4)] backdrop-blur-md whitespace-nowrap">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]"></span>
                <span class="font-bold tracking-wide">Open to work</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </Container>




  <!-- Down-Arrow Indicator (Image 2 bottom arrow) -->
  <div class="flex justify-center pt-8 relative z-10">
    <a href="#about" class="text-slate-400 hover:text-cyan-400 transition-colors p-2 animate-bounce" aria-label="Scroll down">
      <ArrowDown className="w-5 h-5 text-cyan-400/80" />
    </a>
  </div>

</section>


