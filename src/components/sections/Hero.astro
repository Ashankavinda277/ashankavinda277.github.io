---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/data/site';
import { socialLinks } from '@/data/social';
import { ArrowRight, Github, Linkedin, Mail, FileText } from 'lucide-react';
---

<section class="flex min-h-[calc(100vh-4rem)] flex-col justify-center py-16 sm:py-24">
  <Container size="full">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">

      <!-- Left Column: Typography & CTAs -->
      <div class="lg:col-span-7 space-y-6">

        {siteConfig.availability.status && (
          <p class="inline-flex items-center gap-2 text-sm text-muted-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-foreground"></span>
            <span>{siteConfig.availability.text}</span>
          </p>
        )}

        <div class="space-y-3">
          <h1 class="text-4xl font-semibold leading-tight tracking-tight text-foreground sm:text-5xl lg:text-6xl">
            {siteConfig.name}
          </h1>
          <p class="text-lg text-muted-foreground sm:text-xl">
            {siteConfig.role} · {siteConfig.affiliation}
          </p>
        </div>

        <p class="max-w-xl text-base leading-relaxed text-muted-foreground">
          {siteConfig.bio}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <Button href="#projects" variant="primary" size="lg">
            <span>View My Work</span>
            <ArrowRight className="w-4 h-4" />
          </Button>

          <Button href="#contact" variant="secondary" size="lg">
            <span>Get In Touch</span>
          </Button>
        </div>

        <!-- Social Icons Row -->
        <div class="flex items-center gap-2 pt-2">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target={social.url.startsWith('http') ? '_blank' : undefined}
              rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex h-9 w-9 items-center justify-center rounded-control border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
              aria-label={social.name}
            >
              {social.iconName === 'github' && <Github className="w-4 h-4" />}
              {social.iconName === 'linkedin' && <Linkedin className="w-4 h-4" />}
              {(social.iconName === 'mail' || social.iconName === 'email') && <Mail className="w-4 h-4" />}
            </a>
          ))}

          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-control border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            aria-label="Download Resume"
            title="Download Resume (PDF)"
          >
            <FileText className="w-4 h-4" />
          </a>
        </div>

      </div>

      <!-- Right Column: Portrait -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <img
          src="/images/profile/avatar.jpeg"
          alt={siteConfig.name}
          width="320"
          height="320"
          class="h-56 w-56 rounded-full border border-border object-cover sm:h-72 sm:w-72 lg:h-80 lg:w-80"
          onerror="if (this.src.endsWith('.jpeg')) { this.src = '/images/profile/avatar.png'; } else if (this.src.endsWith('.png')) { this.src = '/images/profile/avatar.jpg'; } else { this.onerror = null; }"
        />
      </div>

    </div>
  </Container>
</section>
