---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/data/site';
import { socialLinks } from '@/data/social';
import { ArrowRight, Github, Linkedin, Mail, FileText } from 'lucide-react';

const meta = [
  { label: 'Location', value: siteConfig.location },
  { label: 'Education', value: 'University of Moratuwa' },
  { label: 'Focus', value: 'Cloud · AI · Web' },
];
---

<section class="flex min-h-[calc(100vh-4rem)] flex-col justify-center py-16 sm:py-20">
  <Container size="full">

    <!-- Top meta line -->
    <div class="flex items-center gap-4 border-b border-border pb-5">
      <span class="text-sm text-muted-foreground">Portfolio</span>
      <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
      {siteConfig.availability.status && (
        <span class="flex items-center gap-2 text-sm text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-foreground" aria-hidden="true"></span>
          {siteConfig.availability.text}
        </span>
      )}
    </div>

    <!-- Display type + portrait -->
    <div class="grid grid-cols-1 items-end gap-10 pt-12 lg:grid-cols-12 lg:gap-12 lg:pt-16">
      <div class="lg:col-span-8">
        <h1 class="text-5xl font-semibold leading-[0.95] tracking-tighter text-foreground sm:text-6xl lg:text-7xl xl:text-8xl">
          {siteConfig.name}
        </h1>
        <p class="mt-3 text-3xl font-semibold leading-[1.05] tracking-tight text-muted-foreground sm:text-4xl lg:text-5xl xl:text-6xl">
          {siteConfig.role}
        </p>
      </div>

      <div class="lg:col-span-4 lg:justify-self-end">
        <img
          src="/images/profile/avatar.jpeg"
          alt={siteConfig.name}
          width="320"
          height="384"
          class="h-64 w-52 rounded-card border border-border object-cover object-top sm:h-80 sm:w-64"
          onerror="if (this.src.endsWith('.jpeg')) { this.src = '/images/profile/avatar.png'; } else if (this.src.endsWith('.png')) { this.src = '/images/profile/avatar.jpg'; } else { this.onerror = null; }"
        />
      </div>
    </div>

    <!-- Spec sheet -->
    <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-6 sm:grid-cols-4 lg:mt-16">
      {meta.map((item) => (
        <div>
          <dt class="text-sm uppercase tracking-wider text-muted-foreground">{item.label}</dt>
          <dd class="mt-1.5 text-sm text-foreground">{item.value}</dd>
        </div>
      ))}
      <div>
        <dt class="text-sm uppercase tracking-wider text-muted-foreground">Connect</dt>
        <dd class="mt-1.5 flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target={social.url.startsWith('http') ? '_blank' : undefined}
              rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-muted-foreground transition-colors hover:text-foreground"
              aria-label={social.name}
            >
              {social.iconName === 'github' && <Github className="w-4 h-4" />}
              {social.iconName === 'linkedin' && <Linkedin className="w-4 h-4" />}
              {(social.iconName === 'mail' || social.iconName === 'email') && <Mail className="w-4 h-4" />}
            </a>
          ))}
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground transition-colors hover:text-foreground"
            aria-label="Download Resume"
            title="Download Resume (PDF)"
          >
            <FileText className="w-4 h-4" />
          </a>
        </dd>
      </div>
    </dl>

    <!-- Bio + CTAs -->
    <div class="mt-12 grid grid-cols-1 gap-8 border-t border-border pt-8 lg:grid-cols-12">
      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground lg:col-span-7">
        {siteConfig.bio}
      </p>

      <div class="flex flex-wrap items-start gap-3 lg:col-span-5 lg:justify-end">
        <Button href="#projects" variant="primary" size="lg">
          <span>View My Work</span>
          <ArrowRight className="w-4 h-4" />
        </Button>
        <Button href="#contact" variant="secondary" size="lg">
          <span>Get In Touch</span>
        </Button>
      </div>
    </div>

  </Container>
</section>
