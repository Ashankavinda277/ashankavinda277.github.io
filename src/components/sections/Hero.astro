---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import CircuitBackground from '@/components/ui/CircuitBackground.astro';
import { siteConfig } from '@/data/site';
import { socialLinks } from '@/data/social';
import { ArrowRight, Github, Linkedin, Mail, FileText } from 'lucide-react';

const meta = [
  { label: 'Location', value: siteConfig.location },
  { label: 'Education', value: 'University of Moratuwa' },
  { label: 'Focus', value: 'Cloud · AI · Web' },
];

// "Full-Stack Developer" -> full-strength first word, dimmed remainder. The
// two-tone heading survives the move to monochrome by inverting which half
// it emphasises: with no accent hue to colour the lead word, the contrast
// comes from the *rest* of the phrase dropping to --muted-foreground.
// Splitting on the first space keeps this generic if the role text changes.
const [roleLead, ...roleRestWords] = siteConfig.role.split(' ');
const roleRest = roleRestWords.join(' ');

// Short phrases the hero subtitle types out and deletes on a loop.
const taglines = [
  'Building scalable web apps',
  'Cloud-native solutions on AWS',
  'Turning ideas into software',
];
---

<section class="relative flex min-h-[calc(100vh-4rem)] flex-col justify-center py-16 sm:py-20">
  <AmbientGlow />
  <CircuitBackground />

  <Container size="full" class="relative">

    <!-- Top meta line -->
    <div data-reveal data-reveal-now class="flex items-center gap-4 border-b border-border pb-5">
      <span data-reveal="rule" data-reveal-now class="h-px flex-1 bg-border" aria-hidden="true"></span>
      {siteConfig.availability.status && (
        <span class="flex items-center gap-2 text-sm text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-foreground" aria-hidden="true"></span>
          {siteConfig.availability.text}
        </span>
      )}
    </div>

    <!-- Display type + portrait -->
    <div class="grid grid-cols-1 items-end gap-10 pt-12 lg:grid-cols-12 lg:gap-12 lg:pt-16">
      <div class="lg:col-span-8">
        <h1 class="text-5xl font-semibold leading-[0.95] tracking-tighter text-foreground sm:text-6xl lg:text-7xl xl:text-8xl">
          <span class="block overflow-hidden pb-[0.12em]">
            <span data-reveal="mask" data-reveal-now class="block">{siteConfig.name}</span>
          </span>
        </h1>
        <p class="mt-3 text-3xl font-semibold leading-[1.05] tracking-tight sm:text-4xl lg:text-5xl xl:text-6xl">
          <span class="block overflow-hidden pb-[0.12em]">
            <span data-reveal="mask" data-reveal-now class="block">
              <span class="text-foreground">{roleLead}</span>{roleRest && <span class="text-muted-foreground"> {roleRest}</span>}
            </span>
          </span>
        </p>

        <p data-reveal data-reveal-now class="mt-4 text-lg text-muted-foreground sm:text-xl">
          <span id="hero-typewriter" aria-hidden="true"></span><span class="typewriter-cursor" aria-hidden="true">|</span>
          <span class="sr-only">{taglines[0]}</span>
        </p>
      </div>

      <div data-reveal data-reveal-now class="lg:col-span-4 lg:justify-self-end">
        <img
          src="/images/profile/avatar.jpeg"
          alt={siteConfig.name}
          width="320"
          height="384"
          class="h-64 w-52 rounded-card border border-border object-cover object-top transition-transform duration-500 hover:scale-102 sm:h-80 sm:w-64"
          onerror="if (this.src.endsWith('.jpeg')) { this.src = '/images/profile/avatar.png'; } else if (this.src.endsWith('.png')) { this.src = '/images/profile/avatar.jpg'; } else { this.onerror = null; }"
        />
      </div>
    </div>

    <!-- Spec sheet -->
    <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-6 sm:grid-cols-4 lg:mt-16">
      {meta.map((item) => (
        <div data-reveal data-reveal-now>
          <dt class="text-sm uppercase tracking-wider text-muted-foreground">{item.label}</dt>
          <dd class="mt-1.5 text-sm text-foreground">{item.value}</dd>
        </div>
      ))}
      <div data-reveal data-reveal-now>
        <dt class="text-sm uppercase tracking-wider text-muted-foreground">Connect</dt>
        <dd class="mt-1.5 flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target={social.url.startsWith('http') ? '_blank' : undefined}
              rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-muted-foreground transition-colors hover:text-foreground"
              aria-label={social.name}
            >
              {social.iconName === 'github' && <Github className="w-4 h-4" />}
              {social.iconName === 'linkedin' && <Linkedin className="w-4 h-4" />}
              {(social.iconName === 'mail' || social.iconName === 'email') && <Mail className="w-4 h-4" />}
            </a>
          ))}
          <a
            href={siteConfig.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground transition-colors hover:text-foreground"
            aria-label="Download Resume"
            title="Download Resume (PDF)"
          >
            <FileText className="w-4 h-4" />
          </a>
        </dd>
      </div>
    </dl>

    <!-- Bio + CTAs -->
    <div data-reveal data-reveal-now class="mt-12 grid grid-cols-1 gap-8 border-t border-border pt-8 lg:grid-cols-12">
      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground lg:col-span-7">
        {siteConfig.bio}
      </p>

      <div class="flex flex-wrap items-start gap-3 lg:col-span-5 lg:justify-end">
        <Button href="#projects" variant="primary" size="lg">
          <span>View My Work</span>
          <ArrowRight className="w-4 h-4" />
        </Button>
        <Button href="#contact" variant="secondary" size="lg">
          <span>Get In Touch</span>
        </Button>
      </div>
    </div>

  </Container>
</section>

<style>
  .typewriter-cursor {
    color: hsl(var(--foreground));
    animation: typewriter-blink 1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      animation: none;
    }
  }

  @keyframes typewriter-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
</style>

<script define:vars={{ taglines }}>
  const target = document.getElementById('hero-typewriter');
  if (target) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !taglines.length) {
      target.textContent = taglines[0] ?? '';
    } else {
      let phraseIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const phrase = taglines[phraseIndex % taglines.length];
        charIndex += deleting ? -1 : 1;
        target.textContent = phrase.slice(0, charIndex);

        let delay = deleting ? 18 : 32;

        if (!deleting && charIndex === phrase.length) {
          deleting = true;
          delay = 900;
        } else if (deleting && charIndex === 0) {
          deleting = false;
          phraseIndex += 1;
          delay = 200;
        }

        setTimeout(tick, delay);
      };

      tick();
    }
  }
</script>
