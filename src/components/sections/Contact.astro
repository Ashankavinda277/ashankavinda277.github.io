---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ContactForm } from '@/components/interactive/ContactForm';
import { socialLinks } from '@/data/social';
import { Mail, ArrowUpRight, Github, Linkedin } from 'lucide-react';
---

<section id="contact" class="py-16 sm:py-24 border-b border-border/40 scroll-mt-16">
  <Container size="lg" class="space-y-12">
    <SectionHeading
      kicker="Get In Touch"
      title="Have an idea?"
      description="Let's build something."
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Contact Info & Direct Links -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-foreground">
            Let's connect and discuss your project.
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            I am always open to discussing new opportunities, software projects, open-source collaborations, or cloud architecture ideas. Drop me a message and I'll get back to you as soon as possible.
          </p>
        </div>

        <!-- Direct Social Links List -->
        <div class="space-y-3 pt-4 border-t border-border/40">
          <h4 class="font-mono text-xs uppercase tracking-wider text-muted-foreground">
            Direct Reach & Socials
          </h4>

          <div class="space-y-2 font-mono text-xs">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3 rounded-lg border border-border/60 bg-card hover:border-accent/40 hover:bg-accent-muted/50 text-foreground transition-all duration-200 group"
              >
                <div class="flex items-center gap-3">
                  {social.iconName === 'github' && <Github className="w-4 h-4 text-accent" />}
                  {social.iconName === 'linkedin' && <Linkedin className="w-4 h-4 text-accent" />}
                  {social.iconName === 'mail' && <Mail className="w-4 h-4 text-accent" />}
                  <span class="font-medium">{social.name}</span>
                </div>
                <div class="flex items-center gap-1 text-muted-foreground group-hover:text-accent">
                  <ArrowUpRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Interactive Form Card -->
      <div class="lg:col-span-7">
        <div class="rounded-xl border border-border/70 bg-card p-6 sm:p-8 shadow-sm">
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </Container>
</section>
