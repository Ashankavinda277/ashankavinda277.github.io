---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ExploringPanel } from '@/components/interactive/ExploringPanel';
import { explorationTopics } from '@/data/exploring';
---

<section id="exploring" class="scroll-mt-16 border-t border-border bg-surface py-20 sm:py-28">
  <Container size="full" class="space-y-14">

    <SectionHeading
      kicker="Currently Exploring"
      title="What I'm Learning"
      description="Areas I'm actively studying and building with, beyond coursework."
    />

    <ExploringPanel topics={explorationTopics} client:visible />

  </Container>
</section>
