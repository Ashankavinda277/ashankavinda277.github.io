---
import Container from '@/components/ui/Container.astro';
import SectionMarker from '@/components/ui/SectionMarker.astro';
import { ExploringPanel } from '@/components/interactive/ExploringPanel';
import { explorationTopics } from '@/data/exploring';
---

<section id="exploring" class="scroll-mt-16 py-24 sm:py-32">
  <Container size="full" class="space-y-12">

    <SectionMarker number="05" label="Exploring" data-reveal />

    <h2 data-reveal class="max-w-3xl text-2xl font-semibold leading-snug tracking-tight text-foreground sm:text-3xl">
      Areas I'm actively studying and building with, beyond coursework.
    </h2>

    <div data-reveal>
      <ExploringPanel topics={explorationTopics} client:visible />
    </div>

  </Container>
</section>
