---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ExploringInteractive } from '@/components/interactive/ExploringInteractive';
---

<section id="exploring" class="py-20 lg:py-28 border-b border-blue-500/10 scroll-mt-16 bg-[#040717]">
  <Container size="full" class="space-y-16">

    <SectionHeading
      kicker="Continuous Learning"
      title="Currently Exploring"
      description="Domains and concepts I am actively researching, experimenting with, and building real projects around."
      align="center"
    />

    <ExploringInteractive client:visible />

  </Container>
</section>
